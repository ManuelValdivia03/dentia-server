# =========================================================
# Dentia - Environment Example
# Copy this file as .env and replace unsafe demo values.
# Do NOT commit real credentials.
# =========================================================

# Global
NODE_ENV=development
JWT_SECRET=dentia_dev_jwt_secret_change_me_32_chars_minimum
INTERNAL_API_KEY=dev-internal-key-change-me

# API Gateway
API_GATEWAY_PORT=3000

# Auth Service
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://auth-service:3001
ACCESS_TOKEN_TTL=2m
REFRESH_TOKEN_IDLE_TIMEOUT_SECONDS=300
REFRESH_TOKEN_ABSOLUTE_TTL_SECONDS=28800
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT_MAX=3
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_VERIFY_EMAIL_RATE_LIMIT_MAX=5
AUTH_VERIFY_EMAIL_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RESEND_VERIFICATION_RATE_LIMIT_MAX=3
AUTH_RESEND_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_REQUEST_PASSWORD_RESET_RATE_LIMIT_MAX=3
AUTH_REQUEST_PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RESET_PASSWORD_RATE_LIMIT_MAX=5
AUTH_RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_TTL_MINUTES=10
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_LOCKOUT_SECONDS=900

# Appointments Service - C#
APPOINTMENTS_HTTP_PORT=3002
APPOINTMENTS_SERVICE_URL=http://appointments-service:3002

# Prescriptions Service
PRESCRIPTIONS_SERVICE_PORT=3003
PRESCRIPTIONS_TCP_HOST=0.0.0.0
PRESCRIPTIONS_TCP_PORT=4002
APPOINTMENTS_SERVICE_URL=http://appointments-service:3002

# Chat Service
CHAT_SERVICE_PORT=3004
CHAT_SERVICE_URL=http://chat-service:3004
CHAT_MONGODB_URI=mongodb://chat-mongo:27017/dentia_chat

# Files Service - C#
FILES_SERVICE_PORT=3005
FILES_SERVICE_URL=http://files-service:8080
FILES_MONGODB_URI=mongodb://files-mongo:27017/dentia_files

# Reports Service
REPORTS_SERVICE_PORT=3006
REPORTS_SERVICE_URL=http://reports-service:3006

# PostgreSQL
POSTGRES_USER=dentia
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
POSTGRES_AUTH_DB=dentia_auth
POSTGRES_APPOINTMENTS_DB=dentia_appointments
POSTGRES_PRESCRIPTIONS_DB=dentia_prescriptions

# RabbitMQ
RABBITMQ_URL=amqp://dentia:dentia123@rabbitmq:5672
RABBITMQ_QUEUE_APPOINTMENTS=appointments_events
RABBITMQ_DEFAULT_USER=dentia
RABBITMQ_DEFAULT_PASS=change_me

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_AUTH=neo4j/change_me

# Mail / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dentia <no-reply@dentia.local>"

# Email verification
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_LOCKOUT_SECONDS=900
