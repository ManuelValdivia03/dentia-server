{
  "info": {
    "_postman_id": "aaf17df4-5381-4dd9-a947-3adca665219d",
    "name": "Dentia Chat MVP - Newman",
    "description": "Pruebas automatizadas Postman/Newman para chat-service MVP de Dentia. Incluye pruebas de seguridad sin credenciales de dentista y flujo completo con credenciales de dentista.",
