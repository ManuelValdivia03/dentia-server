          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 72 * 60 * 60 * 1000);",
                  "start.setUTCHours(18, 0, 0, 0);",
                  "const end = new Date(start.getTime() + 60 * 60 * 1000);",
                  "pm.environment.set('fullAppointmentStartAt', start.toISOString());",
