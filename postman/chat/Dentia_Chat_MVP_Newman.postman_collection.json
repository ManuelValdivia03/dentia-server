  "item": [
    {
      "name": "Chat Security MVP - runnable without dentist credentials",
      "description": "Pruebas que deben correr con el entorno local actual sin contraseña de dentista. Valida health, JWT, relación paciente-dentista y bloqueos de acceso.",
      "item": [
        {
          "name": "Health - chat-service",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{chatServiceUrl}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('chat-service health responde 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('servicio correcto', function () { pm.expect(json.service).to.eql('chat-service'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway blocks chat without JWT",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/chat/conversations",
            "description": "Valida que el API Gateway proteja /chat/* con JWT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sin JWT debe responder 401', function () { pm.response.to.have.status(401); });",
                  "const json = pm.response.json();",
                  "pm.test('mensaje Token requerido', function () { pm.expect(json.message).to.eql('Token requerido'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register patient for chat security tests",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Paciente Chat Newman\",\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.environment.set('patientEmail', `paciente.chat.${suffix}@dentia.com`);",
                  "pm.environment.set('patientPassword', 'Password123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registro paciente 200/201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const json = pm.response.json();",
                  "pm.test('rol PATIENT', function () { pm.expect(json.role).to.eql('PATIENT'); });",
                  "pm.test('domainId paciente existe', function () { pm.expect(json.domainId).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('patientId', json.domainId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login paciente 200/201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const json = pm.response.json();",
                  "pm.test('accessToken existe', function () { pm.expect(json.accessToken).to.be.a('string').and.not.empty; });",
                  "pm.test('user.domainId coincide', function () { pm.expect(json.user.domainId).to.eql(pm.environment.get('patientId')); });",
                  "pm.environment.set('patientToken', json.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "List patient conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/conversations",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('lista conversaciones 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('respuesta es arreglo', function () { pm.expect(json).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List dentists and store dentistId",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dentists",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('dentists responde 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('existe al menos un dentista seed', function () { pm.expect(json).to.be.an('array').and.not.empty; });",
                  "pm.test('dentista tiene domainId', function () { pm.expect(json[0].domainId).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('dentistId', json[0].domainId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create PENDING appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": "{{baseUrl}}/appointments",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"dentistId\": \"{{dentistId}}\",\n  \"startAt\": \"{{appointmentStartAt}}\",\n  \"endAt\": \"{{appointmentEndAt}}\",\n  \"reason\": \"Prueba Newman chat\",\n  \"notes\": \"Cita PENDING para probar bloqueo de chat sin relaci\\u00f3n confirmada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 48 * 60 * 60 * 1000);",
                  "start.setUTCHours(16, 0, 0, 0);",
                  "const end = new Date(start.getTime() + 60 * 60 * 1000);",
                  "pm.environment.set('appointmentStartAt', start.toISOString());",
                  "pm.environment.set('appointmentEndAt', end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('crear cita 200/201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const json = pm.response.json();",
                  "pm.test('cita inicia PENDING', function () { pm.expect(json.status).to.eql('PENDING'); });",
                  "pm.environment.set('appointmentId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Internal relation is false before confirmation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-internal-api-key",
                "value": "{{internalApiKey}}"
              }
            ],
            "url": "{{appointmentsServiceUrl}}/internal/relationships/patient-dentist?patientId={{patientId}}&dentistId={{dentistId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('endpoint interno responde 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('relación no permitida antes de CONFIRMED/COMPLETED', function () { pm.expect(json.allowed).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Block conversation without valid relation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/conversations",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"dentistId\": \"{{dentistId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sin cita confirmada debe responder 403', function () { pm.response.to.have.status(403); });",
                  "const json = pm.response.json();",
                  "pm.test('mensaje de relación inválida', function () { pm.expect(JSON.stringify(json)).to.include('valid relation'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Patient cannot confirm appointment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/confirm",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('paciente no puede confirmar cita', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chat Full Flow - requires dentist credentials",
