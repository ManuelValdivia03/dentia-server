        {
          "name": "Full - Login dentist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Requiere dentistEmail y dentistPassword. Si no existen, este folder debe fallar: es un pendiente real del proyecto.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{dentistEmail}}\",\n  \"password\": \"{{dentistPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('dentistEmail configurado', function () { pm.expect(pm.environment.get('dentistEmail'), 'Set dentistEmail').to.be.a('string').and.not.empty; });",
                  "pm.test('dentistPassword configurado', function () { pm.expect(pm.environment.get('dentistPassword'), 'Set dentistPassword').to.be.a('string').and.not.empty; });",
                  "pm.test('login dentista 200/201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const json = pm.response.json();",
                  "pm.test('rol DENTIST o ADMIN', function () { pm.expect(['DENTIST', 'ADMIN']).to.include(json.user.role); });",
                  "pm.environment.set('dentistToken', json.accessToken);",
                  "if (json.user.domainId) { pm.environment.set('fullDentistId', json.user.domainId); }"
                ]
              }
            }
          ]
